{
  "name": "ariadne",
  "version": "1.17.0",
  "description": "Ariadne \u2014 a single-user, local-first personal project & task tracker",
  "main": "./out/main/index.js",
  "private": true,
  "author": "Tim Howland <th@wdogsystems.com>",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thowland/ariadne.git"
  },
  "bugs": {
    "url": "https://github.com/thowland/ariadne/issues"
  },
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "screenshots": "electron-vite build && node scripts/screenshots.mjs",
    "release:tag": "node scripts/tag-release.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "package": "npm run package:linux",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:win": "electron-vite build && bash scripts/package-win.sh",
    "package:win:native": "electron-vite build && electron-builder --win --publish never",
    "package:mac:universal": "electron-vite build && electron-builder --mac --universal --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@fontsource/public-sans": "^5.2.7",
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^18.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.wdogsystems.ariadne",
    "productName": "Ariadne",
    "copyright": "Copyright \u00a9 2026 Tim Howland \u2014 GPL-3.0-or-later",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "th@wdogsystems.com"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "notarize": false,
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 240
        },
        {
          "x": 410,
          "y": 240,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 90,
          "type": "file",
          "path": "docs/DISTRIBUTION_README.md",
          "name": "README.txt"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    }
  },
  "overrides": {
    "@noble/hashes": "^1.8.0",
    "canvas": "^3.2.3"
  },
  "homepage": "https://github.com/thowland/ariadne#readme"
}
